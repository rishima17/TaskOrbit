{
  "name": "taskorbit-backend",
  "version": "1.0.0",
  "description": "TaskOrbit - Production-ready Distributed Asynchronous Task Queue & Webhook Processing Platform Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/combined.js",
    "start:api": "node src/server.js",
    "start:worker": "node src/workers/worker.js",
    "start:cluster": "node src/combined.js",
    "worker": "node src/workers/worker.js",
    "dev:server": "nodemon --env-file=.env src/server.js",
    "dev:worker": "nodemon --env-file=.env src/workers/worker.js",
    "dev": "concurrently \"nodemon --env-file=.env src/server.js\" \"nodemon --env-file=.env src/workers/worker.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}

