PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/task_queue_db

# Redis Standalone
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# Redis Cloud / Managed URL (e.g. Upstash, Redis Cloud)
# REDIS_URL=redis://default:password@redis-12345.c1.us-east-1.redns.redis-cloud.com:12345

# Redis Cluster Mode (Multi-Node / High-Availability)
# REDIS_CLUSTER_NODES=127.0.0.1:7000,127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003,127.0.0.1:7004,127.0.0.1:7005

JWT_SECRET=supersecret_jwt_key_production_ready_999888
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CROSS_DOMAIN=false

